rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isNewUserTrialValid() {
      return (!('createdAt' in request.resource.data)
          || request.resource.data.createdAt <= request.time + duration.value(5, 'm'))
        && (!('trialEndsAt' in request.resource.data)
          || request.resource.data.trialEndsAt <= request.time + duration.value(31, 'd'));
    }

    function isTrialExtensionValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trialEndsAt'])
        && ('createdAt' in resource.data)
        && request.resource.data.trialEndsAt <= resource.data.createdAt + duration.value(31, 'd');
    }

    function protectedSubscriptionFields() {
      return [
        'isPro',
        'paypalSubscriptionId',
        'paypalStatus',
        'planType',
        'currentPeriodEnd',
        'cancelAtPeriodEnd',
        'adminProOverride',
        'subscriptionStartDate',
        'subscriptionUpdatedAt',
        'lastPaypalWebhookEventId',
        'paypalPaymentFailedAt',
        'trialEndsAt',
        'createdAt'
      ];
    }

    function hasOnlyClientAllowedSubscriptionDefaults() {
      return !request.resource.data.keys().hasAny([
        'paypalSubscriptionId',
        'paypalStatus',
        'planType',
        'currentPeriodEnd',
        'adminProOverride',
        'subscriptionStartDate',
        'subscriptionUpdatedAt',
        'lastPaypalWebhookEventId',
        'paypalPaymentFailedAt'
      ])
      && (!('isPro' in request.resource.data) || request.resource.data.isPro == false)
      && (!('cancelAtPeriodEnd' in request.resource.data) || request.resource.data.cancelAtPeriodEnd == false);
    }

    // Regla estricta: Cada usuario puede leer/escribir SÓLO en su propia ruta de datos
    match /users/{userId} {
      allow read: if isSignedInOwner(userId);
      allow create: if isSignedInOwner(userId)
        && hasOnlyClientAllowedSubscriptionDefaults()
        && isNewUserTrialValid();
      allow update: if isSignedInOwner(userId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedSubscriptionFields())
          || isTrialExtensionValid()
        );
      allow delete: if isSignedInOwner(userId);
      
      match /{document=**} {
        allow read, write: if isSignedInOwner(userId);
      }
    }
    
    // Regla para la colección raíz de transacciones
    match /transactions/{transactionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Las claves de IA viven en Firebase Functions Secrets, nunca en Firestore.
    match /config/gemini {
      allow read, write: if false;
    }

    match /artifacts/finanzas_boveda_dual_v2/public/data/admin_notifications/{notificationId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipient == 'admin@freenanzas-app.web.app'
        && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }

    match /artifacts/finanzas_boveda_dual_v2/public/data/errorLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.errorType == 'IA_SCAN_FAILURE';
      allow read, update, delete: if false;
    }
  }
}
