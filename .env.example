VITE_FIREBASE_API_KEY="Tú_API_KEY_AQUI"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="SENDER_ID"
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Gemini se configura como secreto de Firebase Functions:
# firebase functions:secrets:set GEMINI_API_KEY

# Webhook URL para reporte de errores (n8n u otro)
VITE_N8N_WEBHOOK_URL="https://tu-n8n.com/webhook/error-report"

# PayPal Settings
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID_MONTHLY=
VITE_PAYPAL_PLAN_ID_ANNUAL=
VITE_PAYPAL_FALLBACK_MONTHLY=
VITE_PAYPAL_FALLBACK_ANNUAL=

# Legacy aliases read by older local env files. Prefer the PLAN_ID names above.
# VITE_PAYPAL_PLAN_MONTHLY=
# VITE_PAYPAL_PLAN_ANNUAL=

# Marketing & Afiliados
VITE_AFFILIATE_LOAN_LINK="https://ejemplo-banco.com/afiliado"
